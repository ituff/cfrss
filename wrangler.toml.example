# Example Worker configuration.
#
# The repo ships `wrangler.toml` with a placeholder `database_id` so the real
# D1 resource id never enters version control. After cloning:
#
#   1. put the id in `.dev.vars` (gitignored):
#        D1_DATABASE_ID=<your-d1-database-id>
#   2. run:
#        bash scripts/set-d1-id.sh
#
# Get the id with `npx wrangler d1 list`, or from the Cloudflare dashboard.

name = "cfrss"
main = "src/index.ts"
compatibility_date = "2024-12-30"

# 自定义域名：替换为你自己的域名；不需要则可整段删除，
# Worker 会改从 <name>.<subdomain>.workers.dev 访问。
routes = [
  { pattern = "rss.example.com", custom_domain = true }
]

# ===== 定时任务：每小时整点自动抓取订阅新文章（新文章以未读状态呈现） =====
[triggers]
crons = ["0 * * * *"]

[vars]
# 每次定时任务最多刷新的订阅数（免费版 10ms CPU 限制，超出部分按最旧优先在后续小时轮转）
CRON_MAX_FEEDS = "10"

[assets]
directory = "./public"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*"]

[[d1_databases]]
binding = "DB"
database_name = "cfrss-db"
database_id = "<injected locally — see the header comment>"
migrations_dir = "migrations"